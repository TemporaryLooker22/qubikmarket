# Base PostgreSQL. Sur Vercel, ces deux variables sont ajoutées automatiquement par l'intégration Neon.
DATABASE_URL="postgresql://qubik:qubik@localhost:5432/qubik"
DATABASE_URL_UNPOOLED="postgresql://qubik:qubik@localhost:5432/qubik"

# Longue chaîne aléatoire (au moins 32 caractères), par exemple le résultat de : openssl rand -hex 32
SESSION_SECRET="remplace-moi-par-une-longue-chaine-aleatoire"

# Adresse publique du site (ex. https://qubikmarket.com)
APP_URL="http://localhost:3000"

# Vercel Blob (stockage des fichiers). Ajouté automatiquement sur Vercel. Vide = stockage local.
BLOB_READ_WRITE_TOKEN=""

# Vide = mode démo (achats simulés). Clé de test Stripe : sk_test_...
STRIPE_SECRET_KEY=""
