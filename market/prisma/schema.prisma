// Base de données de Qubik (PostgreSQL).
// Sur Vercel, la base est fournie par Neon : les deux adresses sont ajoutées automatiquement.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // connexion "poolée", pour le site
  directUrl = env("DATABASE_URL_UNPOOLED") // connexion directe, pour les migrations
}

model User {
  id           String     @id @default(cuid())
  username     String     @unique
  email        String     @unique
  passwordHash String
  role         String     @default("USER") // USER ou ADMIN
  createdAt    DateTime   @default(now())
  resources    Resource[]
  purchases    Purchase[]
}

model Resource {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  summary     String
  description String
  category    String
  priceCents  Int      // 0 = gratuit
  status      String   @default("PENDING") // PENDING, APPROVED ou REJECTED
  reviewNote  String?  // message du modérateur au vendeur

  // Résultat du scanner anti-backdoor
  scanVerdict String   // clean, suspicious ou dangerous
  scanScore   Int
  scanReport  String   // rapport complet en JSON

  fileName    String
  filePath    String
  fileSize    Int

  // Captures d'écran (adresses publiques, jusqu'à 6). La première sert de miniature.
  images      String[] @default([])

  sellerId    String
  seller      User       @relation(fields: [sellerId], references: [id])
  purchases   Purchase[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status, createdAt])
}

model Purchase {
  id              String   @id @default(cuid())
  userId          String
  resourceId      String
  amountCents     Int
  status          String   @default("PENDING") // PENDING ou PAID
  stripeSessionId String?  @unique
  createdAt       DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id])
  resource Resource @relation(fields: [resourceId], references: [id])

  @@unique([userId, resourceId])
}
