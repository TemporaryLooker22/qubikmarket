// Base de données de Qubik (PostgreSQL).
// Sur Vercel, la base est fournie par Neon : les deux adresses sont ajoutées automatiquement.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // connexion "poolée", pour le site
  directUrl = env("DATABASE_URL_UNPOOLED") // connexion directe, pour les migrations
}

model User {
  id                    String               @id @default(cuid())
  username              String               @unique
  email                 String               @unique
  passwordHash          String
  role                  String               @default("USER") // USER ou ADMIN
  createdAt             DateTime             @default(now())
  // Vendeur fondateur : commission réduite jusqu'à cette date (voir lib/sellers.ts)
  founderUntil          DateTime?
  // Compte Stripe du vendeur pour recevoir ses gains (Stripe Connect), et s'il peut déjà recevoir des virements
  stripeAccountId       String?              @unique
  stripeTransfersActive Boolean              @default(false)
  payouts               SellerPayout[]
  resources             Resource[]
  purchases             Purchase[]
  earnings              SellerEarning[]
  reviews               Review[]
  // Bannissement par un modérateur : plus de connexion, ressources retirées de la vente, avis masqués (réversible)
  bannedAt              DateTime?
  banReason             String?
  // Provenance à l'inscription (voir components/SourceTracker.tsx) : site ou campagne d'origine, adresse du lien,
  // page d'arrivée et pays (déduit de l'adresse IP par Vercel, l'adresse IP n'est pas gardée)
  signupSource          String?
  signupReferrer        String?
  signupLanding         String?
  signupCountry         String?
  reviewReports         ReviewReport[]
  moderationLogs        ModerationLog[]
  notifications         Notification[]
  // Messagerie entre membres (voir lib/chat.ts)
  lastSeenAt            DateTime? // dernière activité sur le site (point vert « en ligne » dans les messages)
  conversationsA        Conversation[]       @relation("ConversationA")
  conversationsB        Conversation[]       @relation("ConversationB")
  messages              Message[]
  blocks                Block[]              @relation("Blocker")
  blockedBy             Block[]              @relation("Blocked")
  conversationReports   ConversationReport[]
  // Profil public (/u/pseudo) : photo recadrée (Vercel Blob) et avis entre membres (voir lib/member-reviews.ts)
  avatarUrl             String?
  memberReviewsWritten  MemberReview[]       @relation("MemberReviewAuthor")
  memberReviewsReceived MemberReview[]       @relation("MemberReviewTarget")
  memberReviewReports   MemberReviewReport[]
}

model Resource {
  id          String  @id @default(cuid())
  slug        String  @unique
  title       String
  summary     String
  description String
  category    String
  priceCents  Int // 0 = gratuit
  status      String  @default("PENDING") // ANALYZING (analyse IA en cours), PENDING, APPROVED, REJECTED ou UNLISTED (retirée de la vente)
  reviewNote  String? // message du modérateur au vendeur

  // Résultat du scanner anti-backdoor
  scanVerdict String // clean, suspicious ou dangerous
  scanScore   Int
  scanReport  String // rapport complet en JSON

  fileName String
  filePath String
  fileSize Int

  // Captures d'écran (adresses publiques, jusqu'à 6). La première sert de miniature.
  images  String[] @default([])
  // Vidéo de présentation YouTube (facultative) : l'identifiant de la vidéo, affichée en premier dans la galerie
  videoId String?

  // Version en ligne : les champs fichier et scan ci-dessus sont toujours ceux de cette version
  version          String            @default("1.0")
  versionUpdatedAt DateTime? // dernière mise à jour du fichier (vide tant que c'est la version d'origine)
  versions         ResourceVersion[]
  // Badge « Contenu vérifié » : l'analyse IA de la version en ligne confirme que le contenu correspond à la description
  aiVerified       Boolean           @default(false)

  // Avis des acheteurs : note moyenne et nombre d'avis (recalculés à chaque avis, voir lib/reviews.ts)
  ratingAvg   Float    @default(0)
  ratingCount Int      @default(0)
  ratingScore Float    @default(0) // pour le tri « Mieux notées » (moyenne pondérée par le nombre d'avis)
  reviews     Review[]

  // Retirée de la vente parce que son vendeur a été banni : elle revient en ligne s'il est débanni
  unlistedByBan Boolean @default(false)

  sellerId  String
  seller    User       @relation(fields: [sellerId], references: [id])
  purchases Purchase[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([status, createdAt])
}

model Purchase {
  id                    String    @id @default(cuid())
  userId                String
  resourceId            String
  amountCents           Int
  // PENDING (paiement pas terminé), PAID, REFUNDED (remboursé) ou DISPUTED (contestation bancaire en cours).
  // Seul PAID donne accès au téléchargement.
  status                String    @default("PENDING")
  stripeSessionId       String?   @unique
  stripePaymentIntentId String?   @unique // pour retrouver l'achat lors d'un remboursement ou d'une contestation
  paidAt                DateTime? // moment du paiement (createdAt = début du paiement)
  taxCents              Int       @default(0) // TVA comprise dans amountCents (calculée par Stripe Tax)
  // Frais de service payés par l'acheteur (compris dans amountCents) et leur TVA (comprise dans taxCents) : pour Qubik
  buyerFeeCents         Int       @default(0)
  buyerFeeTaxCents      Int       @default(0)
  lastDownloadedAt      DateTime? // dernier téléchargement (pour le badge « Nouvelle version » de Mes achats)
  createdAt             DateTime  @default(now())

  user     User           @relation(fields: [userId], references: [id])
  resource Resource       @relation(fields: [resourceId], references: [id])
  earning  SellerEarning?

  @@unique([userId, resourceId])
}

// Registre des gains des vendeurs : une ligne par vente payée (et une ligne négative pour une
// régularisation, quand une vente déjà versée au vendeur est remboursée).
// Les versements chaque semaine additionnent les lignes « PENDING » dont le délai de sécurité est passé.
model SellerEarning {
  id          String   @id @default(cuid())
  sellerId    String
  purchaseId  String?  @unique // la vente d'origine (vide pour une régularisation)
  reversesId  String?  @unique // régularisation : le gain déjà versé qu'elle annule
  amountCents Int // ce que touche le vendeur (négatif pour une régularisation)
  grossCents  Int      @default(0) // payé par l'acheteur, TVA comprise
  taxCents    Int      @default(0) // TVA reversée par Qubik
  feeCents    Int      @default(0) // commission de Qubik
  feePercent  Int      @default(10)
  // PENDING (à verser), PAID (versé au vendeur), CANCELED (vente remboursée ou contestée avant le versement)
  status      String   @default("PENDING")
  availableAt DateTime // fin du délai de sécurité (7 jours après le paiement) : versable à partir de cette date
  transferId  String? // virement Stripe qui l'a versé
  payoutId    String? // versement hebdomadaire qui l'inclut (ou qui est en train de l'inclure)
  createdAt   DateTime @default(now())

  seller   User           @relation(fields: [sellerId], references: [id])
  purchase Purchase?      @relation(fields: [purchaseId], references: [id])
  reverses SellerEarning? @relation("Reversal", fields: [reversesId], references: [id])
  reversal SellerEarning? @relation("Reversal")
  payout   SellerPayout?  @relation(fields: [payoutId], references: [id])

  @@index([sellerId, status])
}

// Versements hebdomadaires : un virement Stripe par vendeur, qui regroupe ses gains disponibles
model SellerPayout {
  id            String   @id @default(cuid())
  sellerId      String
  amountCents   Int
  // PROCESSING (virement en cours, repris au prochain passage si interrompu), PAID (versé) ou FAILED (échec, gains remis en attente)
  status        String   @default("PROCESSING")
  transferId    String?  @unique
  failureReason String?
  createdAt     DateTime @default(now())

  seller   User            @relation(fields: [sellerId], references: [id])
  earnings SellerEarning[]

  @@index([sellerId, createdAt])
}

// Historique des fichiers d'une ressource : chaque nouvelle version passe au scanner
model ResourceVersion {
  id          String  @id @default(cuid())
  resourceId  String
  version     String // numéro choisi par le vendeur (1.0, 1.2, 2.0.1…)
  notes       String? // « Quoi de neuf ? », affiché sur la page produit
  fileName    String
  filePath    String
  fileSize    Int
  scanVerdict String
  scanScore   Int
  scanReport  String
  // ANALYZING (analyse IA en cours), LIVE (celle que les acheteurs téléchargent), OLD (ancienne), PENDING (en modération) ou REJECTED (refusée)
  status      String
  reviewNote  String?

  // Analyse IA du contenu (voir lib/ai) : notes sur 100, constats et conseils (JSON), signalement
  aiStatus      String? // QUEUED (dans la file d'attente), PENDING (en cours), DONE ou FAILED (analyse impossible)
  aiMatch       Int? // correspondance avec la description
  aiQuality     Int? // qualité du contenu
  aiDescription Int? // description complète et utile pour l'acheteur (0 à 100)
  aiFlagged     Boolean? // une des deux notes sous le seuil
  aiReport      String? // { summary, findings: [{ level, text }], tips: [] }
  aiAt          DateTime? // entrée dans la file, puis fin de l'analyse
  aiLanguage    String? // langue du vendeur pour les constats et conseils (fr ou en)
  aiAttempts    Int       @default(0)
  aiReviewed    Boolean   @default(false) // signalement déjà examiné par un modérateur
  createdAt     DateTime  @default(now())

  resource Resource @relation(fields: [resourceId], references: [id])

  @@unique([resourceId, version])
  @@index([resourceId, createdAt])
}

// Verrou court pour qu'un seul serveur à la fois traite une file d'attente (ex. « ai-queue »)
model Lease {
  name  String   @id
  until DateTime
}

// Avis d'un acheteur sur une ressource qu'il a téléchargée : une note de 1 à 5, un commentaire facultatif
// et une réponse publique facultative du vendeur. Un avis par personne et par ressource (modifiable).
model Review {
  id         String    @id @default(cuid())
  resourceId String
  userId     String
  rating     Int // 1 à 5
  body       String? // commentaire (1000 caractères au plus)
  version    String // version de la ressource au moment de l'avis
  reply      String? // réponse du vendeur
  repliedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  resource Resource       @relation(fields: [resourceId], references: [id])
  user     User           @relation(fields: [userId], references: [id])
  reports  ReviewReport[]

  @@unique([userId, resourceId])
  @@index([resourceId, createdAt])
}

// Signalement d'un avis par un membre (insultes, spam…) : il apparaît dans la modération jusqu'à ce qu'un
// modérateur supprime l'avis ou ignore le signalement
model ReviewReport {
  id          String    @id @default(cuid())
  reviewId    String
  userId      String // qui a signalé
  reason      String?
  createdAt   DateTime  @default(now())
  dismissedAt DateTime? // signalement ignoré par un modérateur

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@unique([reviewId, userId])
}

// Journal des décisions de modération (qui, quoi, quand, avec la note envoyée)
model ModerationLog {
  id          String   @id @default(cuid())
  moderatorId String
  action      String // APPROVE, REJECT, KEEP, UNLIST, RELIST, EDIT, DELETE, REANALYZE, REVIEW_DELETE, REPORTS_DISMISS, BAN, UNBAN
  targetType  String // resource, version, review ou user
  targetId    String
  label       String // ce qui est concerné, au moment de la décision (titre, pseudo…)
  note        String?
  createdAt   DateTime @default(now())

  moderator User @relation(fields: [moderatorId], references: [id])

  @@index([createdAt])
}

// Notification d'un membre (cloche de la barre de navigation) : une vente, une ressource en ligne ou refusée,
// un avis, une nouvelle version d'un achat… Le texte est écrit à l'affichage, dans la langue du visiteur,
// à partir du type et des données (voir lib/notifications.ts et le bloc « notif » des dictionnaires).
model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  data      Json      @default("{}")
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Conversation privée entre deux membres (un seul fil par paire : userAId est le plus petit des deux identifiants).
// Les infos du dernier message sont recopiées ici pour afficher la liste et les non-lus sans tout relire.
model Conversation {
  id            String    @id @default(cuid())
  userAId       String
  userBId       String
  startedById   String // qui a écrit en premier (limite de nouvelles conversations par jour)
  readA         DateTime? // dernière lecture de chacun (« Vu » et non-lus)
  readB         DateTime?
  lastMessageAt DateTime  @default(now())
  lastSenderId  String?
  lastPreview   String    @default("")
  createdAt     DateTime  @default(now())

  userA    User                 @relation("ConversationA", fields: [userAId], references: [id], onDelete: Cascade)
  userB    User                 @relation("ConversationB", fields: [userBId], references: [id], onDelete: Cascade)
  messages Message[]
  reports  ConversationReport[]

  @@unique([userAId, userBId])
  @@index([userAId, lastMessageAt])
  @@index([userBId, lastMessageAt])
  @@index([startedById, createdAt])
}

// Message d'une conversation. kind ABOUT : carte « À propos de [ressource] » ajoutée quand on contacte
// un vendeur depuis une ressource.
model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  kind           String    @default("TEXT") // TEXT ou ABOUT
  body           String    @default("")
  images         String[]  @default([]) // jusqu'à 4 images (Vercel Blob)
  resourceId     String? // carte ABOUT
  offPlatform    Boolean   @default(false) // parle de payer ailleurs (PayPal, Discord…) : alerte affichée
  replyMs        Int? // temps mis pour répondre au message de l'autre (temps de réponse du vendeur)
  deletedAt      DateTime? // supprimé par la modération
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
}

// Membre bloqué : il ne peut plus écrire à celui qui l'a bloqué (et inversement)
model Block {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
}

// Signalement d'une conversation : seules les conversations signalées sont lisibles par la modération
model ConversationReport {
  id             String    @id @default(cuid())
  conversationId String
  userId         String // qui a signalé
  reason         String // SCAM, OFF_PLATFORM, HARASSMENT ou OTHER
  note           String?
  createdAt      DateTime  @default(now())
  dismissedAt    DateTime? // traité par un modérateur

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([dismissedAt])
}

// Avis entre membres, affichés sur le profil de celui qui est noté :
// - role SELLER : un acheteur note un vendeur chez qui il a acheté et téléchargé
// - role BUYER : un vendeur note un client qui a téléchargé une de ses ressources
// Un seul avis par auteur, membre noté et rôle (modifiable). Celui qui est noté peut répondre publiquement.
model MemberReview {
  id        String    @id @default(cuid())
  authorId  String
  targetId  String
  role      String // SELLER ou BUYER : le rôle du membre noté
  rating    Int // 1 à 5
  body      String?
  reply     String? // réponse du membre noté
  repliedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  author  User                 @relation("MemberReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  target  User                 @relation("MemberReviewTarget", fields: [targetId], references: [id], onDelete: Cascade)
  reports MemberReviewReport[]

  @@unique([authorId, targetId, role])
  @@index([targetId, role, createdAt])
}

// Signalement d'un avis sur un membre (comme ReviewReport pour les avis de ressources)
model MemberReviewReport {
  id          String    @id @default(cuid())
  reviewId    String
  userId      String
  reason      String?
  createdAt   DateTime  @default(now())
  dismissedAt DateTime?

  review MemberReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
}
