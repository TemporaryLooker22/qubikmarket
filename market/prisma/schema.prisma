// Base de données de Qubik.
// En développement, on utilise SQLite (un simple fichier). En production, on passera à PostgreSQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(cuid())
  username     String     @unique
  email        String     @unique
  passwordHash String
  role         String     @default("USER") // USER ou ADMIN
  createdAt    DateTime   @default(now())
  resources    Resource[]
  purchases    Purchase[]
}

model Resource {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  summary     String
  description String
  category    String
  priceCents  Int      // 0 = gratuit
  status      String   @default("PENDING") // PENDING, APPROVED ou REJECTED
  reviewNote  String?  // message du modérateur au vendeur

  // Résultat du scanner anti-backdoor
  scanVerdict String   // clean, suspicious ou dangerous
  scanScore   Int
  scanReport  String   // rapport complet en JSON

  fileName    String
  filePath    String
  fileSize    Int

  sellerId    String
  seller      User       @relation(fields: [sellerId], references: [id])
  purchases   Purchase[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status, createdAt])
}

model Purchase {
  id              String   @id @default(cuid())
  userId          String
  resourceId      String
  amountCents     Int
  status          String   @default("PENDING") // PENDING ou PAID
  stripeSessionId String?  @unique
  createdAt       DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id])
  resource Resource @relation(fields: [resourceId], references: [id])

  @@unique([userId, resourceId])
}
